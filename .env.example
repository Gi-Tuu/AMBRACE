# ===== AI 服务配置（二选一，推荐 A）=====
# 方式 A（推荐，开源安全）：key 全部留空，部署后由主账号调用
#   PUT /api/v1/system/api-config/server  填一次服务器级全局配置（落库，代码/.env 零密钥）
#   或各用户自行配置用户级 BYOK：PUT /api/v1/system/api-config（聊天主链路优先）
# 方式 B（单机自用/旧版）：直接把 key 填在下方 .env（.env 不随开源包分发）

# ---- LLM（OpenAI 兼容，服务器级/用户级配置均未设置时作为最后兜底）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM 模型名（默认与 backend/app/config.py 一致；留空则回退该默认值 deepseek-v4-pro）
LLM_MODEL=deepseek-v4-pro

# 通用 OpenAI 兼容覆盖（可选；留空则回退 deepseek_*）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# ---- 生图（推荐同 LLM：主账号 PUT /api/v1/system/image-gen-config/server 落库，此处留空；provider: openai=OpenAI 兼容 images/generations；dashscope=qwen-image 系列走 chat 生图）----
IMAGE_GEN_PROVIDER=
IMAGE_GEN_ENABLED=false
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=
IMAGE_GEN_DAILY_LIMIT=10

# ---- 服务器配置 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---- 数据库配置 ----
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/ai_companion.db

# ---- ChromaDB 持久化目录 ----
CHROMA_PERSIST_DIR=./data/vector_store

# ---- 图片理解（识图/识文）----
# 默认关闭本地 VLM。生效优先级：VLM_API_KEY（云端视觉，推荐）> VLM_ENABLED=true（本地 Ollama）> 仅本地 OCR 识文
# 方式一（云端视觉，推荐）：VLM_API_KEY 填云端 Key + VLM_BASE_URL 填 OpenAI 兼容端点（如阿里云百炼 https://xxx/compatible-mode/v1）+ VLM_MODEL 填视觉模型（如 qwen-vl-max）
# 方式二（本地离线）：VLM_ENABLED=true，并安装 Ollama 与 qwen2.5vl:3b 模型（运行 python scripts/setup_local_vlm.py 一键下载）
VLM_ENABLED=false
VLM_API_KEY=
VLM_BASE_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5vl:3b
VLM_TIMEOUT_SEC=180
# ---- 本地 VLM（Ollama）自愈重启（可选，留空不启用）----
VLM_OLLAMA_EXE=
VLM_OLLAMA_MODELS_DIR=
# ---- 安全（2026-08-06 新增）----
# JWT 签名密钥：留空=首次启动自动生成随机密钥并持久化 backend/data/auth_secret.key（重启不失效，推荐）
# 如需固定：AUTH_SECRET_KEY=请填64位随机十六进制
AUTH_SECRET_KEY=
# 服务器级 API 配置管理账号（逗号分隔的 user_id，默认 1=主账号）
ADMIN_USER_IDS=[1]  # 格式：[1] 或逗号分隔 1,2
